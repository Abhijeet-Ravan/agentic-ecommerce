# --- Agni shopping agent -----------------------------------------------------
# Server-side only. The browser never sees these: it calls /api/agni/call, which
# proxies POST {AGNI_API_URL}/calling/create-call and returns LiveKit credentials.
# The voice widget stays hidden until both are set.
AGNI_API_KEY=
AGNI_AGENT_ID=

# Backend base the proxy forwards to.
AGNI_API_URL=https://api.ravan.ai/api/v1

# Public origin of THIS app. Read by scripts/agni-functions.mjs to build each
# tool's url (it strips a trailing slash, so either form is fine). Agni calls
# those endpoints from its own servers, so in development this must be a tunnel
# (ngrok/cloudflared) — the script refuses a localhost value. Not dead config:
# without it the registered tools point nowhere.
AGNI_PUBLIC_URL=

# Shared secret Agni sends back as `X-Agni-Action-Secret` on every function call.
# Without it, anyone who learns a session id can drive that shopper's browser.
# Optional in dev; required in production, where the endpoints 404 without it.
AGNI_ACTION_SECRET=

# How often the in-page bridge drains the action queue (ms). Default 1200.
NEXT_PUBLIC_AGNI_POLL_MS=

# Set to 1 for the on-page action console and bridge logging. Local dev only.
NEXT_PUBLIC_AGNI_DEBUG=

